{
  "name": "agamya",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agamya: captures the reasoning behind expert action, discovers when it applies, and measures whether someone else can apply it.",
  "scripts": {
    "start": "node server.mjs",
    "start:api": "PROCESS_ROLE=api node server.mjs",
    "start:worker": "PROCESS_ROLE=worker node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "acceptance": "node scripts/acceptance.mjs",
    "adversarial": "node scripts/adversarial.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "stability": "node scripts/detect-stability.mjs 5",
    "deploy": "bash scripts/deploy/cloudrun.sh"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "11.2.0",
    "@google-cloud/storage": "^8.2.0",
    "@google/genai": "^2.21.0",
    "@resvg/resvg-js": "^2.6.2",
    "fastify": "^5.12.5",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "axe-core": "4.10.2",
    "jsdom": "25.0.1"
  }
}
