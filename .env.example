# Copy to .env for local development. Production values come from Cloud Run env vars and Secret Manager.

# ---- AI: Gemini on Vertex AI with Application Default Credentials (gcloud auth application-default login)
GOOGLE_CLOUD_PROJECT="your-gcp-project"
GOOGLE_CLOUD_LOCATION="us-central1"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TTS_MODEL="gemini-2.5-flash-tts"
EMBED_MODEL="text-embedding-005"
# GEMINI_TIMEOUT_MS="40000"       # per attempt; transient failures are retried once
# Gemini API key instead of Vertex (takes precedence if set). Prefer Vertex + service account in production.
# GEMINI_API_KEY=""
# Run with deterministic fallbacks and no model calls:
# AGAMYA_OFFLINE="1"
# Default monthly AI budget per organization (USD); admins can change it per org.
# AI_MONTHLY_BUDGET_USD="50"

# ---- Runtime
# PORT="3200"
# PROCESS_ROLE="all"            # all (local) | api | worker
# PUBLIC_ORIGIN="http://localhost:3200"   # must be https in production; used for Origin checks and invite links
# LOG_LEVEL="info"

# ---- Database: embedded PGlite (WASM Postgres) when DATABASE_URL is unset
# PGLITE_DIR="./data/pg"        # or "memory"
# DATABASE_URL="postgres://app:...@/kindred?host=/cloudsql/PROJECT:REGION:INSTANCE"
# DB_POOL_MAX="10"
# DB_SSL="0"

# ---- Object storage: local disk unless STORAGE_DRIVER=gcs (required in production)
# STORAGE_DRIVER="gcs"
# GCS_BUCKET="your-bucket"
# STORAGE_DIR="./data/objects"
# SIGNED_URL_TTL_SEC="300"

# ---- Identity
# ALLOW_SIGNUP="1"              # default on in dev, off in production
# SESSION_TTL_HOURS="12"
# SESSION_IDLE_MINUTES="120"
# MAX_FAILED_LOGINS="5"
# LOCKOUT_MINUTES="15"
# IP_HASH_SALT=""               # required in production (>= 16 random chars)
# Enterprise SSO (OIDC, e.g. Google Workspace):
# OIDC_ISSUER="https://accounts.google.com"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_LABEL="Google"

# ---- Samples
# Per-visitor sample spaces from the landing page (featured Living Knowledge journey, Work sample). Default on in dev.
# SAMPLE_SPACES="1"
# SAMPLE_AI_BUDGET_USD="2"      # monthly AI budget of each sample space
# SAMPLE_DAILY_CAP="300"        # sample spaces created per 24 h, all visitors together
# Shared demo organization used by scripts and tests (default on in dev, off in production)
# DEMO_SEED="1"
# DEMO_LOGIN="1"                # password-free sign-in to the shared demo org only (never a sample space or real org)
# DEMO_PASSWORD=""              # shared demo users' password for scripts; local use only

# ---- Voice
# VOICE_PROVIDER="google"       # text-to-speech provider (src/ai/voice.mjs); speech-to-text uses Gemini

# ---- Jobs and media limits
# JOB_CONCURRENCY="4"
# JOB_POLL_MS="500"
# MAX_FRAME_BYTES="3000000"
# MAX_AUDIO_BYTES="6000000"
# MAX_VIDEO_BYTES="25000000"
# MAX_DOC_BYTES="10000000"

# Test harness only: exposes answer keys so scripted learners can play "wrong then right". Ignored in production.
# TEST_HOOKS="1"
