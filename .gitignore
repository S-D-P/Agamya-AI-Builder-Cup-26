node_modules/
.env
# Local database, uploaded media and generated objects never leave the machine.
data/*
# Measured evidence is versioned so the claims in the docs can be checked.
!data/benchmark.json
!data/adversarial.json
!data/eval-redaction.json
!data/eval-workmap.json
!data/eval/
!data/storage-benchmark.json

# Local presentation template and raw demo recordings (not part of the source)
*.MOV
*.mov
*.pptx
# (the editable deck is kept locally; only the PDF is published)
submission-build/

# Demo video: upload to YouTube; too large for the repository
docs/submission/*.mp4

